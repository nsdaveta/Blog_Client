{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Build Manager Pro",
  "version": "1.0.0",
  "identifier": "com.build.manager.pro",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Build Manager Pro",
        "width": 1000,
        "height": 750,
        "resizable": true,
        "transparent": true,
        "decorations": true
      }                                                   
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Navjot Singh Daveta",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
