{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blog Build Manager",
  "version": "1.0.0",
  "identifier": "com.blog.build.manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Blog Build Master",
        "width": 1000,
        "height": 750,
        "resizable": true,
        "transparent": true,
        "decorations": true
      }                                                   
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Navjot Singh Daveta",
    "targets": "all",
    "windows": {
      "signCommand": "c:\\Blog_Client\\build-manager\\sign-app.bat %1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
