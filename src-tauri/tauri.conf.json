{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blogify",
  "version": "1.0.3",
  "identifier": "com.blog.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blogify",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 450,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": { 
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Navjot Singh Daveta",
    "targets": "all",
    "licenseFile": "LICENSE.txt",
    "resources": [
      "LICENSE.txt",
      "README.txt",
      "ThirdPartyNotices.txt",
      "assets/*",
      "docs/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
          "language": "en-US"
       },
      "signCommand": "sign-app.bat %1",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
